{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./secrets/**)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.p8)",
      "Read(./**/*.pem)",
      "Edit(./reference/**)",
      "Write(./reference/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
