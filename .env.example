# Copy to .env and fill in the values yourself. Never commit .env.
# Claude cannot read .env (blocked in .claude/settings.json); it only knows these names.
# Each block says which phase first needs it. docs/SETUP.md says where to get each value.

# --- Local dev stack (Phase 0) ---
POSTGRES_USER=firstfifty
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=firstfifty
DATABASE_URL=jdbc:postgresql://localhost:5432/firstfifty
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 1) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate locally, e.g. in Git Bash: openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Alerts (Phase 1) ---
TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# --- Edge, bot protection, file storage (Phase 1-2) ---
# Scoped token: DNS edit + R2 for this zone only
CLOUDFLARE_API_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Encryption (Phase 1) ---
# 32-byte key-encryption key for resumes (base64). Production keeps it in the cluster's secret store.
RESUME_KEK_BASE64=

# --- Observability (Phase 1) ---
SENTRY_DSN=
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_TOKEN=

# --- AI (Phase 2-3) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_DAILY_BUDGET_INR=200

# --- Payments (Phase 3) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Mobile builds (Phase 3) ---
EXPO_TOKEN=
